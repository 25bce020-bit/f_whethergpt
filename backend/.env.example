# Required secrets (set these only in the hosting platform's secret environment).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
GROQ_API_KEY=replace-with-secret

# Production web deployment: use the exact public frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=https://frontend.example.com
AUTH_COOKIE_SECURE=true
# For a cross-site frontend/backend deployment, use none. It requires Secure=true.
AUTH_COOKIE_SAMESITE=none
AUTH_SESSION_LIFETIME_DAYS=14

# Optional runtime tuning.
REALTIME_LOCATIONS=Delhi,Mumbai,Kolkata
OPEN_METEO_CACHE_TTL=900
GFS_CACHE_TTL=3600
IMD_CACHE_TTL=300
VOICE_MAX_AUDIO_SIZE_MB=10

# IMD Agromet / GKMS Configuration (Optional - for registered IMD API Gateway credentials)
# IMD_AGROMET_API_KEY=your_imd_api_portal_key_here
# IMD_AGROMET_BASE_URL=https://api.imd.gov.in/api/v1/agromet
# IMD_MEGHDOOT_BASE_URL=https://meghdoot.imd.gov.in/api
# IMD_AGROMET_TIMEOUT_SECONDS=5.0
# IMD_AGROMET_CACHE_TTL=10800
